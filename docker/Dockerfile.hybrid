# Multi-stage build for the hybrid Go+Rust ext_proc server (Config B).

# --- Stage 1: Build Rust cdylib ---
FROM rust:latest AS rust-builder

RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY rust/Cargo.toml rust/Cargo.lock* ./
COPY rust/crates/ ./crates/
COPY rust/proto/ ./proto/

RUN cargo build --release -p ipp-ffi \
    && strip target/release/libipp_ffi.so 2>/dev/null || true

# --- Stage 2: Build Go binary ---
FROM golang:1.23 AS go-builder

RUN apt-get update && apt-get install -y gcc && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy Rust cdylib
COPY --from=rust-builder /build/target/release/libipp_ffi.so /usr/local/lib/

# Copy Go bridge source (includes ipp_ffi.h for cgo)
COPY go-bridge/ ./go-bridge/

WORKDIR /build/go-bridge

ENV CGO_ENABLED=1
ENV CGO_LDFLAGS="-L/usr/local/lib -lipp_ffi -Wl,-rpath,/usr/local/lib"

RUN go mod download && go build -o /bbr-hybrid .

# --- Stage 3: Runtime ---
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3t64 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-builder /build/target/release/libipp_ffi.so /usr/local/lib/
COPY --from=go-builder /bbr-hybrid /bbr-hybrid

RUN ldconfig && useradd -r -u 1001 ipp
USER 1001:1001

EXPOSE 9004 9005

ENTRYPOINT ["/bbr-hybrid"]
